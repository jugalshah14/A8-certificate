PORT=5000
CORS_ORIGIN=http://localhost:5173

# Signing tokens. Use a long random string outside local development.
AUTH_SECRET=change-me-to-a-long-random-string

# Google sign-in: OAuth client ID (type "Web application") from
# https://console.cloud.google.com/apis/credentials. Add http://localhost:5173
# (and your https tunnel/production URL) under Authorised JavaScript origins.
GOOGLE_CLIENT_ID=
# Your Google email; added as the first admin when the team is empty.
BOOTSTRAP_ADMIN_EMAIL=

# Fallback password sign-in, acts as an admin. Leave empty to allow Google only.
ADMIN_PASSWORD=admin

# Base URL written to NFC chips and QR codes. A phone must be able to open it:
# use your LAN address (http://192.168.x.x:5173) or a tunnel URL (https://...).
# Leave empty to use the address the admin page is opened on.
PUBLIC_BASE_URL=

# Blockchain. Defaults to a local Hardhat chain (`npm run chain`), where the
# registry contract deploys itself on first use.
RPC_URL=http://127.0.0.1:8545
# For a public testnet, e.g. Polygon Amoy:
# RPC_URL=https://rpc-amoy.polygon.technology
# PRIVATE_KEY=0x...            (funded testnet key, never a real wallet)
# CONTRACT_ADDRESS=0x...       (from `npm run deploy`)
# CHAIN_NAME=Polygon Amoy testnet
# EXPLORER_URL=https://amoy.polygonscan.com
