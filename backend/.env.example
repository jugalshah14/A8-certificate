PORT=5000
CORS_ORIGIN=http://localhost:5173

# Admin sign-in. Change both before deploying anywhere.
ADMIN_PASSWORD=admin
AUTH_SECRET=change-me-to-a-long-random-string

# Base URL written to NFC chips and QR codes. A phone must be able to open it:
# use your LAN address (http://192.168.x.x:5173) or a tunnel URL (https://...).
# Leave empty to use the address the admin page is opened on.
PUBLIC_BASE_URL=

# Blockchain. Defaults to a local Hardhat chain (`npm run chain`), where the
# registry contract deploys itself on first use.
RPC_URL=http://127.0.0.1:8545
# For a public testnet, e.g. Polygon Amoy:
# RPC_URL=https://rpc-amoy.polygon.technology
# PRIVATE_KEY=0x...            (funded testnet key, never a real wallet)
# CONTRACT_ADDRESS=0x...       (from `npm run deploy`)
# CHAIN_NAME=Polygon Amoy testnet
# EXPLORER_URL=https://amoy.polygonscan.com
